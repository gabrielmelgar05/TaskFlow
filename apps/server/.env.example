# Copie para .env e preencha com os valores do seu PostgreSQL local.
# A porta externa do banco em compose.yaml é 5433.
DATABASE_URL=postgresql://SEU_USUARIO:SUA_SENHA@localhost:5433/SEU_BANCO?schema=public
PORT=3001
# Origens explícitas: Next dev nas portas 3000/3002 e Wrangler na 8788.
CORS_ORIGIN=http://localhost:3000,http://localhost:3002,http://localhost:8788
NODE_ENV=development
COOKIE_SECURE=false
SESSION_TTL_DAYS=7
# Em produção: NODE_ENV=production, COOKIE_SECURE=true e origem HTTPS.
# Configure o mesmo segredo aleatório (mínimo 32 caracteres) no Render e Pages.
# API_PROXY_SECRET=
